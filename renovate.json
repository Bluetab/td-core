{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "enabledManagers": [
    "mix"
  ],
  "baseBranchPatterns": [
    "main"
  ],
  "branchPrefix": "chore/",
  "groupName": "all dependencies",
  "groupSlug": "td-dependency-management",
  "groupSingleUpdates": true,
  "separateMajorMinor": false,
  "automerge": false,
  "prConcurrentLimit": 1,
  "prHourlyLimit": 1,
  "lockFileMaintenance": {
    "enabled": false
  }
}
